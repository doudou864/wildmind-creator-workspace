{
  "name": "wildmind-creator-workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src scripts",
    "format:check": "prettier --check src scripts",
    "prepare": "git config core.hooksPath .githooks",
    "db:migrate": "node --experimental-strip-types scripts/db-migrate.mjs",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run",
    "browser:login": "node --experimental-strip-types scripts/browser-login.mjs",
    "browser:check": "node --experimental-strip-types scripts/browser-check.mjs",
    "check": "node scripts/check-all.mjs",
    "collect": "node --experimental-strip-types scripts/collect.mjs",
    "collect:resume": "node --experimental-strip-types scripts/collect.mjs --resume",
    "collect:install": "node --experimental-strip-types scripts/install-collector.mjs",
    "collect:attention": "node --experimental-strip-types scripts/attention.mjs",
    "data:show": "node --experimental-strip-types scripts/data-show.mjs"
  },
  "dependencies": {
    "@openai/codex-sdk": "^0.163.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "echarts": "^6.1.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
